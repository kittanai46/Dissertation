NODE_ENV=development
HOST=0.0.0.0
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=class_tracking
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=mysql_nodejs
DB_CONNECTION_LIMIT=10

# Use at least two long, random comma-separated values in production.
SESSION_KEYS=replace-key-1,replace-key-2
API_TOKEN_SECRET=replace-with-a-long-random-token-secret
API_TOKEN_TTL_SECONDS=86400
COOKIE_SECURE=false
CORS_ORIGINS=*

# Optional: required only by the legacy notification endpoint.
FCM_SERVER_KEY=
ALLOW_REGISTRATION=false
